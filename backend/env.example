# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ai_advisor

# OpenAI
OPENAI_API_KEY=your_openai_api_key
# Optional: Custom OpenAI-compatible API endpoint (for LiteLLM, etc.)
# OPENAI_API_BASE=https://your-litellm-endpoint.com

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Hubspot OAuth
HUBSPOT_CLIENT_ID=your_hubspot_client_id
HUBSPOT_CLIENT_SECRET=your_hubspot_client_secret
HUBSPOT_REDIRECT_URI=http://localhost:8000/auth/hubspot/callback

# App Config
SECRET_KEY=your_secret_key_here_change_in_production
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Redis (for task queue)
REDIS_URL=redis://localhost:6379/0

